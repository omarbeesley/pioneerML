__pycache__/
*.py[cod]
*.egg-info/
.venv/
build/
dist/
outputs/
.pytest_cache/
# The selected weights belong to this self-contained handoff.
!checkpoints/*.pth
# These tiny, documented examples belong to this release, even inside the old repo.
!examples/*.parquet

